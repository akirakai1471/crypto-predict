# Copy to .env on the server and fill in. .env is in .gitignore: these are
# credentials and must never be committed. Everything here is optional; unset
# means that channel is off. See docs/deploy-vps.md.

# Telegram: signal alerts, high-impact headlines, and "scheduler stopped".
# Token from @BotFather; chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
# after you have sent the bot one message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# A dead-man's switch outside the server, e.g. a healthchecks.io check with a
# 1-hour period and a 2-hour grace. Pinged after every finished cycle; if the
# pings stop - the whole server down included - that service alerts you.
HEALTHCHECK_PING_URL=
